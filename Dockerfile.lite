# Move2link Web LITE — tanpa Chromium/Playwright (jauh lebih ringan).
# Input: paste URL diary / token JWT dari log RedirectGuard.
# Shortlink move2link.co langsung TIDAK bisa dibuka otomatis di versi ini.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Hanya p7zip (untuk extract .7z/.rar); tanpa dependency Chromium.
RUN apt-get update && apt-get install -y --no-install-recommends \
    p7zip-full \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-lite.txt .
RUN pip install -r requirements-lite.txt

COPY . .

ENV M2L_PORT=5000 \
    M2L_DOWNLOADS=/app/downloads
VOLUME ["/app/downloads"]
EXPOSE 5000

CMD ["python3", "app.py"]
